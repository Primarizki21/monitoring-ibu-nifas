# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (form kunjungan bertoken, pengiriman WA). Jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fonnte WhatsApp Gateway (fonnte.com > Device > Token)
FONNTE_TOKEN=

# URL publik aplikasi, dipakai untuk tautan kunjungan /visit/[token]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rahasia untuk endpoint cron SLA (/api/cron/*)
CRON_SECRET=

# Kata sandi akun uji (scripts/buat-akun-uji.mjs). Hanya untuk development.
AKUN_UJI_PASSWORD=
