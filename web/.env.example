# =====================================================================
# SIM-NIFAS — variabel lingkungan. Salin file ini ke .env.local
# (.env.local gitignored). Semua nilai diisi manual; tidak ada yang otomatis.
# =====================================================================

# --- 1. WAJIB: Supabase (Dashboard project > Project Settings) ---------
# Project Settings > Data API (atau API Settings) > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Project Settings > API Keys > publishable key (nama lama: anon).
# Nilai publik: ikut ter-inline ke bundle browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API Keys > secret key (nama lama: service_role).
# HANYA untuk server (route API, worker WA, health). Jangan pernah ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. WAJIB: URL publik aplikasi ------------------------------------
# Dev: http://localhost:3000. Produksi: domain final (dipakai tautan /visit/<token>).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 3. OPSIONAL: gateway WhatsApp (fonnte.com > Device > Token) ------
# Kosong = pesan tetap QUEUED dan jatah retry tidak terpakai.
FONNTE_TOKEN=

# --- 4. OPSIONAL: rahasia endpoint /api/cron --------------------------
# Generate sendiri: openssl rand -hex 32
# Saat cron Supabase diaktifkan, nilai ini harus sama dengan secret
# 'cron_secret' di Supabase Vault. Kosong = /api/cron selalu 401.
CRON_SECRET=

# --- 5. DEV-ONLY: kata sandi akun uji --------------------------------
# Dipakai scripts/buat-akun-uji.mjs untuk 4 akun nakes uji.
AKUN_UJI_PASSWORD=
