# Konfigurasi Aplikasi & Environment
APP_NAME="Sistem Monitoring Kesehatan Ibu Nifas Surabaya"
APP_ENV="development"
DEBUG=true
PORT=8000

# Basis Data (Default: PostgreSQL 16 via Docker Compose)
# Jika PostgreSQL tidak berjalan, sistem otomatis fallback ke SQLite: sqlite:///./nifas_dev.db
DATABASE_URL="postgresql+psycopg://nifas_user:nifas_secret_password@localhost:5432/nifas_db"

# Meta WhatsApp Cloud API (Graph API v20.0+)
# Nilai placeholder untuk dev testing tanpa rahasia sensitif
META_WA_API_URL="https://graph.facebook.com/v20.0"
META_WA_PHONE_NUMBER_ID="100000000000001"
META_WA_ACCESS_TOKEN="EAAxxxxxx_dummy_dev_token"
META_WA_VERIFY_TOKEN="surabaya_nifas_webhook_verify_secret"

# Scheduler Pengiriman Pesan Harian (08.00 WIB)
ENABLE_SCHEDULER=true
SCHEDULER_HOUR_WIB=8
SCHEDULER_MINUTE_WIB=0
RATE_LIMIT_MESSAGES_PER_SECOND=10
